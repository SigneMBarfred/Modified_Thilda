%%  Plotting script for thesis section ZERO FORCE + SCALED + DYN
%last edited: 5th of aug 2026
%forcing: zero forcing
%circulation: scaled and later, dynamic (v2)

%% setup 
clear
close all
ParVal_R

qmult = [0.25 0.50 0.75 1.00 1.25 1.50];

col = lines(length(qmult));

%time = st + 1765

%Reference run is q*1
iref = find(qmult==1);

filename = sprintf( ...
    'OutThilda_Zero_3C_incr_circ_10000yr_q%.2f.mat', ...
    qmult(iref));

load(filename)
time = st + 1765;
%% Cumulated carbon for q*1
%changes in the 3 main reservoirs
%land, ocean, atmosphere
%not necesarry to include in report

global rVa mgt aLL
%Atmosphere (GtC)
Catm = 2*squeeze(sAT(4,1,:))/rVa/mgt; %convert ppm to GtC and takes both hemispheres

%Land (GtC)
LandC = 2*squeeze(sum(sLB,1)); %acc to LandExc_R LB refers to one hemisphere, so x2

%Ocean (GtC)
OceanC = GetOceanCarbonInventory(filename);



%Convert to anomaly
Catm     = Catm - Catm(1);
LandC     = LandC - LandC(1);
OceanC    = OceanC - OceanC(1);


%orient as col vectors so dimensions align
Catm      = Catm(:);
LandC     = LandC(:);
OceanC    = OceanC(:);


time = time(:);

TotalC = Catm + LandC + OceanC;

% Plot cumulated carbon for q*1
figure
hold on
box on

plot(time,TotalC,'k','LineWidth',2.5)
plot(time,OceanC,'b','LineWidth',2)
plot(time,Catm,'r','LineWidth',2)
plot(time,LandC,'g','LineWidth',2)

yline(0,'k:')

xlabel('Year')
ylabel('\Delta Carbon (GtC)')

legend('Total','Ocean', 'Atmosphere', 'Land', 'Location','best')
title('Carbon budget changes relative to 1765 AD for q*1')

grid on
fprintf('Final imbalance = %.4f GtC\n',TotalC(end))

%_____________________end of carbon budget visual code________________________















%onwards to the rest of the scaled files: 

%% load files
Scaled = cell(length(qmult),1); %preallocation

for i = 1:length(qmult)

    file = sprintf('OutThilda_Zero_3C_incr_circ_10000yr_q%.2f.mat',qmult(i));
    Scaled{i} = load(file);

end


%% Sediment: changes in net burial of carbonate through time
%net burial is burial-dissolution
%see if it matches the low atm co2 for 1765-2100 for high circ and how
%there is a high atm co2 for this period for the scaled down circ

figure
hold on
box on
for i = 1:length(qmult)
    filename = sprintf( ...
        'OutThilda_Zero_3C_incr_circ_10000yr_q%.2f.mat', qmult(i));
    [~,CcarbBurial,~] = GetSedimentCarbonBurial(filename);

    %sign convention: burial is negative (leaves ocean, enters sediment)

    %Make burial positive, so now bur>0 means leaves ocean enters sediment
    CcarbBurial = -CcarbBurial;
    plot(time, CcarbBurial, 'LineWidth',2, 'Color',col(i,:))
end

xlabel('Year')
ylabel('Carbonate burial (GtC yr^{-1})')
legend(compose('q/q_0 = %.2f',qmult), 'Location','northeast')
grid on
title('Carbonate burial to sediment under zero forcing, scaled circulation')

%% overlay: atm CO2 and carbonate net burial
%just for the extremes: testing if carbonate could explain co2atm
%developments
figure
tiledlayout(1,2)

qplot = [0.25 1.50];

for k = 1:length(qplot)
    filename = sprintf(...
        'OutThilda_Zero_3C_incr_circ_10000yr_q%.2f.mat',...
        qplot(k));

    load(filename,'st','sAT')
    year = st + 1765;

    % Atmospheric CO2(ppm)
    pCO2 = squeeze(sAT(4,1,:))*1e6;

    %carbonate burial
    [~,CcarbBurial,~] = GetSedimentCarbonBurial(filename);

    %make burial positive
    CcarbBurial = -CcarbBurial;
    
    nexttile
    yyaxis left
    plot(year,pCO2,'b','LineWidth',2)
    ylabel('Atmospheric CO_2 (ppm)')

    yyaxis right
    plot(year,CcarbBurial,'r','LineWidth',2)
    ylabel('Carbonate burial (GtC yr^{-1})') %positive means removed from ocean and brought to sediment
    xlabel('Year')
    title(sprintf('q/q_0 = %.2f',qplot(k)))
    grid on
end
sgtitle('Atmospheric CO_2 and carbonate burial(zero forcing)')


%% ocean carbon over time 
%overlay scaled and dynamimc
%we already have the scaled files loaded

figure
hold on
box on

%loop through the scaled and get inventory
for i = 1:length(qmult)

    filename = sprintf( ...
        'OutThilda_Zero_3C_incr_circ_10000yr_q%.2f.mat', qmult(i));

    OceanC = GetOceanCarbonInventory(filename);
    OceanC = OceanC - OceanC(1);
    plot(time,OceanC,'Color',col(i,:),'LineWidth',1.5)
end

%Dynamic
dynfile = 'OutThilda_ZeroForce_dynamicCirc_10000yr.mat';

OceanDyn = GetOceanCarbonInventory(dynfile);
OceanDyn = OceanDyn - OceanDyn(1);

plot(time,OceanDyn,'k--','LineWidth',3)
xlabel('Year')
ylabel('\Delta Ocean Carbon (GtC)')

title('Zero forcing: Ocean carbon inventory change relative to 1765')

grid on




%% Evolution of carbon stored according to depth through time?
%realistically this is most relevant for decreases of moderate scale,thus
%q*0.5,q*0.75
files = {'OutThilda_Zero_3C_incr_circ_10000yr_q0.50.mat'
    'OutThilda_Zero_3C_incr_circ_10000yr_q0.75.mat'
    'OutThilda_ZeroForce_dynamicCirc_10000yr.mat'};

titles = {'Scaled q = 0.50'
    'Scaled q = 0.75'
    'Dynamic circulation'};
global dm d n %layer dimensions

%show all of this in one fig (2x3)
figure
t = tiledlayout(3,2,'TileSpacing','compact','Padding','compact');
for i = 1:3
    [CarbonLL,CarbonHL] = GetOceanCarbonByLayer(files{i});
    load(files{i},'st')

    year = st + 1765;
    depth = [dm dm+d*(1:n-1)];

    %LOW LATITUDE LL
    nexttile
    imagesc(year,depth,CarbonLL)
    set(gca,'YDir','reverse')
    xlabel('Year')
    ylabel('Depth (m)')
    title([titles{i} ' - LL'])

    clim([-5 5])


    % HIGH LATITUDE HL
    nexttile
    imagesc(year,depth,CarbonHL)
    set(gca,'YDir','reverse')
    xlabel('Year')
    ylabel('Depth (m)')
    title([titles{i} ' - HL'])

    clim([-5 5])

end
cb = colorbar;
cb.Layout.Tile = 'east';
cb.Label.String = '\Delta Carbon inventory (GtC)';
sgtitle('Zero forcing: Change in ocean carbon inventory relative to 1765')





%% Dynamic circ: plots of q through time

%non normalised: 
dynfile = 'OutThilda_ZeroForce_dynamicCirc_10000yr.mat';
S = load(dynfile,'st','sqmax');
time = S.st + 1765;

figure
plot(time,S.sqmax,'k','LineWidth',2)
xlabel('Year')
ylabel('Circulation strength, q (m^3 s^{-1})')
title('Zero forcing: Dynamically evolving circulation')
grid on

%normalised with respect to q_ref:
q0 = aLL*1.8e-8; %aLL from ParVal

figure
plot(time,S.sqmax/q0,'k','LineWidth',2)
yline(1,'k:');
xlabel('Year')
ylabel('q/q_0')
title('Zero forcing: Normalised dynamically evolving circulation')
grid on



